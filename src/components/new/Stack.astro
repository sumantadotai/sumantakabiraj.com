---
import { SKILLS } from '../../data/profile';
import SectionHead from './SectionHead.astro';
---
<section class="reveal" style="max-width:var(--w);margin:0 auto;padding:0 28px 48px">
  <SectionHead num="04" title="Stack" />
  <div style="display:flex;flex-wrap:wrap;gap:9px">
    {SKILLS.map((s) => (
      <span class="chip" style="font-size:13.5px;font-weight:500;padding:8px 14px;border-radius:10px;background:var(--chip);border:1px solid var(--chipbd);color:var(--chipfg)">{s}</span>
    ))}
  </div>
</section>
