---
import { HERO, SOCIALS, PROJECT_DATA, EXPERIENCE, CAREER_START, APPS } from '../../data/profile';

const latest = APPS[0];

const stats = [
  { n: `${new Date().getFullYear() - CAREER_START}+`, l: 'years shipping' },
  { n: `${PROJECT_DATA.length}`, l: 'projects built' },
  { n: `${EXPERIENCE.length}`, l: 'companies' },
];
---
<section style="max-width:var(--w);margin:0 auto;padding:56px 28px 48px">
  <div class="hero">
  <div>
  <h1 class="rise" style="--d:0;margin:0 0 16px;font-size:clamp(36px,5.4vw,46px);line-height:1.06;font-weight:800;letter-spacing:-.035em;color:var(--fg)">
    Hey, I'm <span class="serif acc" style="font-size:1.12em">{HERO.name}</span>.<br />
    I build AI products that ship.
  </h1>
  <p class="rise" style="--d:2;margin:0 0 28px;max-width:540px;font-size:17px;line-height:1.6;color:var(--fg2)">
    {HERO.role} based in {HERO.location} &mdash; currently building <span style="color:var(--fg);font-weight:600">{HERO.building}</span>.
  </p>

  <div class="rise" style="--d:3;display:flex;flex-wrap:wrap;align-items:center;gap:10px 18px">
    <a class="btn btn-p" href={SOCIALS.cal} target="_blank" rel="noreferrer">Book a call &rarr;</a>
    <a class="btn" href="/sumanta-kabiraj-resume.pdf" download>Resume</a>
    <span style="display:flex;gap:16px;align-items:center;padding-left:6px">
    <a class="io" href={SOCIALS.github} target="_blank" rel="noreferrer" aria-label="GitHub" style="color:var(--fg2)">
      <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.7-1.4-1.7-1.1-.8.1-.8.1-.8 1.2.1 1.9 1.3 1.9 1.3 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.3-3.2-.1-.3-.6-1.5.1-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.2 2.9.1 3.2.8.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z"/></svg>
    </a>
    <a class="io" href={SOCIALS.twitter} target="_blank" rel="noreferrer" aria-label="X" style="color:var(--fg2)">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor"><path d="M18.24 2h3.3l-7.2 8.2L23 22h-6.6l-5.2-6.8L5.2 22H2l7.7-8.8L2 2h6.8l4.7 6.2L18.24 2Zm-1.2 18h1.8L7 4h-1.9l12 16Z"/></svg>
    </a>
    <a class="io" href={SOCIALS.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn" style="color:var(--fg2)">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-1 1.83-2 3.77-2 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.6c0-1.34-.02-3.07-1.87-3.07-1.87 0-2.16 1.46-2.16 2.97V21h-4V9Z"/></svg>
    </a>
    <a class="io" href={SOCIALS.email} aria-label="Email" style="color:var(--fg2)">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"/><path d="m3.5 6 8.5 7 8.5-7"/></svg>
    </a>
    </span>
  </div>
  </div>

  <aside class="rise pcard-me" style="--d:2">
    <div class="ring"><img src="/me.jpeg" alt="Sumanta Kabiraj" width="112" height="112" /></div>
    <div style="font-size:17px;font-weight:700;color:var(--fg);margin-top:16px">{HERO.name} Kabiraj</div>
    <div class="mono" style="font-size:11.5px;color:var(--dim);margin-top:2px">{HERO.location} · <span data-clock>IST</span></div>
    <span style="display:inline-flex;align-items:center;gap:8px;margin-top:14px;font-size:12.5px;font-weight:500;padding:5px 11px;border-radius:999px;border:1px solid var(--bd);background:var(--bg);color:var(--fg2)">
      <span class="dot"></span> Available for new projects
    </span>
    {latest && (
      <a href={`/apps/${latest.slug}`} class="nl" style="display:flex;align-items:center;gap:10px;margin-top:16px;padding-top:14px;border-top:1px dashed var(--bd);width:100%;text-align:left">
        {latest.icon && <img src={latest.icon} alt="" width="26" height="26" style="border-radius:7px" />}
        <span style="flex:1;min-width:0">
          <span class="mono" style="display:block;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--dim)">Now shipping</span>
          <span style="font-size:13.5px;font-weight:600;color:var(--fg)">{latest.name} <span class="mono acc" style="font-size:11px;font-weight:400">{latest.status}</span></span>
        </span>
        <span style="color:var(--dim)">&rarr;</span>
      </a>
    )}
  </aside>
  </div>

  <div class="rise" style="--d:5;display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--bd);border-radius:14px;background:var(--card);overflow:hidden">
    {stats.map((s, i) => (
      <div style={`padding:18px 20px;${i ? 'border-left:1px solid var(--bd)' : ''}`}>
        <div style="font-size:28px;font-weight:800;letter-spacing:-.03em;color:var(--fg)">{s.n}</div>
        <div class="mono" style="font-size:11.5px;letter-spacing:.04em;color:var(--dim);margin-top:2px">{s.l}</div>
      </div>
    ))}
  </div>
</section>

<style>
  .hero{display:grid;grid-template-columns:1fr 220px;gap:36px;align-items:center;margin-bottom:40px}
  .pcard-me{display:flex;flex-direction:column;align-items:center;text-align:center;padding:24px 20px 18px;border:1px solid var(--bd);border-radius:20px;background:radial-gradient(240px 160px at 50% 0%,var(--acsoft),transparent 70%),var(--card)}
  .ring{position:relative;width:112px;height:112px;border-radius:50%;padding:3px;background:conic-gradient(from var(--a,0deg),var(--ac),transparent 40%,var(--ac) 70%,transparent);animation:spin 6s linear infinite}
  .ring img{display:block;width:100%;height:100%;border-radius:50%;object-fit:cover;border:3px solid var(--card)}
  @property --a{syntax:'<angle>';inherits:false;initial-value:0deg}
  @keyframes spin{to{--a:360deg}}
  @media (prefers-reduced-motion:reduce){.ring{animation:none}}
  @media (max-width:720px){
    .hero{grid-template-columns:1fr;gap:28px}
    .ring{width:96px;height:96px}
  }
</style>
