---
// Search box + tag chips that filter sibling items marked with data-q (search text)
// and data-tags ("|"-separated, lowercase) inside [data-filter-list].
interface Props {
  placeholder: string;
  tags: { label: string; count: number }[];
}
const { placeholder, tags } = Astro.props;
---
<div class="rise" style="--d:3;margin-bottom:24px">
  <label style="display:flex;align-items:center;gap:10px;padding:0 14px;height:44px;border:1px solid var(--bd);border-radius:12px;background:var(--card);margin-bottom:12px">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--dim)" stroke-width="2.2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <input data-filter-q type="search" placeholder={placeholder} aria-label={placeholder} style="flex:1;min-width:0;border:0;outline:0;background:none;color:var(--fg);font:inherit;font-size:15px" />
    <span data-filter-count class="mono" style="font-size:11.5px;color:var(--dim)"></span>
  </label>
  <div style="display:flex;flex-wrap:wrap;gap:7px">
    <button class="ftag on" data-tag="" type="button">All</button>
    {tags.map((t) => (
      <button class="ftag" data-tag={t.label.toLowerCase()} type="button" disabled={t.count === 0} title={t.count === 0 ? 'Coming soon' : undefined}>
        {t.label} <span class="mono" style="opacity:.6;font-size:11px">{t.count}</span>
      </button>
    ))}
  </div>
</div>
<p data-filter-empty style="display:none;padding:32px 0;text-align:center;color:var(--dim)">Nothing matches.</p>

<style is:global>
  .ftag{font:inherit;font-size:12.5px;padding:6px 12px;border-radius:8px;background:var(--chip);border:1px solid var(--chipbd);color:var(--chipfg);cursor:pointer;transition:border-color .18s,color .18s}
  .ftag:hover:not(:disabled){border-color:var(--acbd);color:var(--ac)}
  .ftag.on,.ftag.on:hover{background:var(--ac);border-color:var(--ac);color:var(--onac)}
  .ftag:disabled{opacity:.4;cursor:default}
</style>
<script is:inline>
  (function () {
    var tag = '';
    function apply() {
      var q = document.querySelector('[data-filter-q]');
      if (!q) return;
      var words = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean), n = 0;
      document.querySelectorAll('[data-filter-list] [data-tags]').forEach(function (el) {
        var ok = (!tag || el.dataset.tags.split('|').indexOf(tag) !== -1) &&
          words.every(function (w) { return el.dataset.q.indexOf(w) !== -1; });
        el.style.display = ok ? '' : 'none';
        if (ok) n++;
      });
      document.querySelector('[data-filter-count]').textContent = n + ' shown';
      document.querySelector('[data-filter-empty]').style.display = n ? 'none' : 'block';
    }
    if (!window.__skFilter) {
      window.__skFilter = true;
      document.addEventListener('input', function (e) { if (e.target.matches('[data-filter-q]')) apply(); });
      document.addEventListener('click', function (e) {
        var b = e.target.closest('.ftag');
        if (!b || b.disabled) return;
        tag = b.dataset.tag;
        document.querySelectorAll('.ftag').forEach(function (x) { x.classList.toggle('on', x === b); });
        apply();
      });
      document.addEventListener('astro:page-load', function () { tag = ''; apply(); });
    }
    apply();
  })();
</script>
