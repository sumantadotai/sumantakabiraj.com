---
import { SOCIALS } from '../../data/profile';
---
<section id="contact" style="max-width:var(--w);margin:0 auto;padding:24px 28px 40px">
  <div style="position:relative;overflow:hidden;padding:44px 36px;border:1px solid var(--bd);border-radius:20px;background:radial-gradient(500px 220px at 100% 0%,var(--glow),transparent 70%),var(--card)">
    <div class="mono acc" style="font-size:12px;letter-spacing:.1em;text-transform:uppercase;margin-bottom:14px">Get in touch</div>
    <h2 style="margin:0 0 12px;font-size:clamp(30px,5vw,40px);line-height:1.1;font-weight:800;letter-spacing:-.03em;color:var(--fg)">
      Have an idea? <span class="serif acc">Let's build it.</span>
    </h2>
    <p style="margin:0 0 26px;max-width:480px;font-size:16px;line-height:1.6;color:var(--fg2)">Open to full-time roles and freelance work &mdash; reach out any way that's easiest.</p>
    <div style="display:flex;flex-wrap:wrap;gap:10px">
      <a class="btn btn-p" href={SOCIALS.cal} target="_blank" rel="noreferrer">Book a call &rarr;</a>
      <a class="btn" href={SOCIALS.email}>Email</a>
      <a class="btn" href={SOCIALS.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      <a class="btn" href={SOCIALS.github} target="_blank" rel="noreferrer">GitHub</a>
      <a class="btn" href="/sumanta-kabiraj-resume.pdf" download>Resume</a>
    </div>
  </div>
</section>
