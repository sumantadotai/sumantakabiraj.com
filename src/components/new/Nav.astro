---
import { getCollection } from 'astro:content';
import { APPS, PROJECT_DATA, SOCIALS } from '../../data/profile';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/apps', label: 'Apps' },
  { href: '/projects', label: 'Projects' },
  { href: '/experience', label: 'Experience' },
  { href: '/blog', label: 'Blog' },
];
const posts = (await getCollection('blog')).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

type Item = { label: string; hint: string; href: string; ext?: boolean };
const groups: [string, Item[]][] = [
  ['Pages', [{ label: 'Home', hint: '/', href: '/' }, ...links.map((l) => ({ label: l.label, hint: l.href, href: l.href }))]],
  ['Apps', APPS.map((a) => ({ label: a.name, hint: a.tagline, href: `/apps/${a.slug}` }))],
  ['Projects', PROJECT_DATA.map((p) => ({ label: p.name, hint: p.techline, href: p.demo ?? p.github ?? '/projects', ext: !!(p.demo ?? p.github)?.startsWith('http') }))],
  ['Writing', posts.map((p) => ({ label: p.data.title, hint: 'post', href: `/blog/${p.id}` }))],
  ['Connect', [
    { label: 'Book a call', hint: 'cal.com', href: SOCIALS.cal, ext: true },
    { label: 'Email', hint: 'me@sumantakabiraj.com', href: SOCIALS.email },
    { label: 'GitHub', hint: '@sumantadotai', href: SOCIALS.github, ext: true },
    { label: 'X', hint: '@sumantadotai', href: SOCIALS.twitter, ext: true },
    { label: 'LinkedIn', hint: 'sumanta-kabiraj', href: SOCIALS.linkedin, ext: true },
    { label: 'Download resume', hint: 'PDF', href: '/sumanta-kabiraj-resume.pdf' },
  ]],
];
---
<header style="position:sticky;top:0;z-index:40;backdrop-filter:blur(14px) saturate(1.4);-webkit-backdrop-filter:blur(14px) saturate(1.4);background:color-mix(in srgb,var(--bg) 72%,transparent);border-bottom:1px solid color-mix(in srgb,var(--bd) 60%,transparent)">
  <nav style="max-width:var(--w);margin:0 auto;padding:14px 28px;display:flex;align-items:center;justify-content:space-between;gap:16px">
    <a href="/" class="mono" aria-label="Home" style="font-size:14px;font-weight:500;color:var(--fg)">sk<span class="acc">.</span></a>
    <div style="display:flex;align-items:center;gap:20px">
      {links.map((l) => (
        <a class="nl navlink" href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <button data-palette-open class="kbtn" aria-label="Open command menu">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <kbd class="mono kbd-hint">&#8984;K</kbd>
      </button>
      <button data-theme-toggle class="kbtn" aria-label="Toggle theme" style="width:34px;justify-content:center;font-size:15px">
        <span data-theme-icon="dark">&#9789;</span><span data-theme-icon="light">&#9788;</span>
      </button>
    </div>
  </nav>
</header>

<dialog id="palette" aria-label="Command menu">
  <div style="display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px solid var(--bd)">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--ac)" stroke-width="2.2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <input id="palette-q" type="text" placeholder="Search pages, apps, projects, posts…" autocomplete="off" spellcheck="false" />
    <kbd class="mono" style="font-size:11px;color:var(--dim);border:1px solid var(--bd);border-radius:5px;padding:2px 6px">esc</kbd>
  </div>
  <div id="palette-list" style="max-height:min(420px,60vh);overflow-y:auto;padding:8px">
    {groups.map(([g, items]) => (
      <div class="pg">
        <div class="mono" style="font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--dim);padding:10px 10px 6px">{g}</div>
        {items.map((it) => (
          <a class="pi" href={it.href} {...(it.ext ? { target: '_blank', rel: 'noreferrer' } : {})} data-q={`${g} ${it.label} ${it.hint}`.toLowerCase()}>
            <span style="font-weight:600;color:var(--fg);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{it.label}</span>
            <span style="font-size:12.5px;color:var(--dim);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{it.hint}</span>
            {it.ext && <span style="margin-left:auto;color:var(--dim)">&nearr;</span>}
          </a>
        ))}
      </div>
    ))}
    <div id="palette-empty" style="display:none;padding:28px;text-align:center;font-size:14px;color:var(--dim)">No results.</div>
  </div>
</dialog>

<script is:inline>
  (function () {
    if (window.__skPalette) return;
    window.__skPalette = true;
    var sel = -1;
    function els() { return { d: document.getElementById('palette'), q: document.getElementById('palette-q') }; }
    function visible() { return Array.prototype.filter.call(document.querySelectorAll('#palette .pi'), function (a) { return a.style.display !== 'none'; }); }
    function mark(i) {
      var v = visible();
      v.forEach(function (a) { a.classList.remove('sel'); });
      sel = Math.max(0, Math.min(i, v.length - 1));
      if (v[sel]) { v[sel].classList.add('sel'); v[sel].scrollIntoView({ block: 'nearest' }); }
    }
    function filter() {
      var t = els().q.value.trim().toLowerCase().split(/\s+/);
      document.querySelectorAll('#palette .pg').forEach(function (g) {
        var any = false;
        g.querySelectorAll('.pi').forEach(function (a) {
          var ok = t.every(function (w) { return a.dataset.q.indexOf(w) !== -1; });
          a.style.display = ok ? '' : 'none';
          any = any || ok;
        });
        g.style.display = any ? '' : 'none';
      });
      document.getElementById('palette-empty').style.display = visible().length ? 'none' : 'block';
      mark(0);
    }
    function open() {
      var e = els();
      if (!e.d || e.d.open) return;
      e.q.value = '';
      filter();
      e.d.showModal();
      e.q.focus();
    }
    document.addEventListener('keydown', function (ev) {
      var e = els();
      if ((ev.metaKey || ev.ctrlKey) && ev.key.toLowerCase() === 'k') { ev.preventDefault(); e.d && e.d.open ? e.d.close() : open(); return; }
      if (ev.key === '/' && !(e.d && e.d.open) && !/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)) { ev.preventDefault(); open(); return; }
      if (!e.d || !e.d.open) return;
      if (ev.key === 'ArrowDown') { ev.preventDefault(); mark(sel + 1); }
      else if (ev.key === 'ArrowUp') { ev.preventDefault(); mark(sel - 1); }
      else if (ev.key === 'Enter') { var v = visible()[sel]; if (v) { ev.preventDefault(); e.d.close(); v.click(); } }
    });
    document.addEventListener('input', function (ev) { if (ev.target.id === 'palette-q') filter(); });
    document.addEventListener('click', function (ev) {
      var e = els();
      if (ev.target.closest('[data-palette-open]')) { open(); return; }
      if (ev.target === e.d) e.d.close(); // backdrop click
      else if (ev.target.closest('#palette .pi')) e.d.close();
    });
  })();
</script>
