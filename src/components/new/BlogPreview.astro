---
import { getCollection } from 'astro:content';
import SectionHead from './SectionHead.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
const latest = posts[0];
---
{latest && (
  <section class="reveal" style="max-width:var(--w);margin:0 auto;padding:0 28px 48px">
    <SectionHead num="05" title="Latest writing" />
    <a href={`/blog/${latest.id}`} class="pcard spot" style="display:block;padding:24px;border:1px solid var(--bd);border-radius:14px;background:var(--card)">
      <div class="mono" style="font-size:12px;color:var(--ac);margin-bottom:8px">
        {latest.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
      </div>
      <div style="font-size:19px;font-weight:700;letter-spacing:-.01em;color:var(--fg);margin-bottom:8px">{latest.data.title}</div>
      <p style="margin:0;font-size:14.5px;color:var(--fg2);line-height:1.6">{latest.data.summary}</p>
      <div style="margin-top:14px;font-size:14px;font-weight:600;color:var(--ac)">Read post &rarr;</div>
    </a>
    <a href="/blog" class="io" style="display:inline-block;margin-top:14px;font-size:14px;font-weight:600;color:var(--fg2)">All posts &rarr;</a>
  </section>
)}
